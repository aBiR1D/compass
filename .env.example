# Compass — LLM Provider Configuration
# Copy this file to .env and fill in your API key.

# Provider: "anthropic" (default) or "openai"
COMPASS_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
COMPASS_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (if using openai provider)
# OPENAI_API_KEY=sk-...
# COMPASS_OPENAI_MODEL=gpt-4o

# Database path (default: ~/.compass/compass.db)
# COMPASS_DB_PATH=~/.compass/compass.db
